	"PreBuildSteps": {
		"Win64": [
			"@echo on & echo Locating Python path & where python.exe /F > tmpPythonPath & set /p PYTHONPATH= < tmpPythonPath & del tmpPythonPath & echo Python path found. & %PYTHONPATH% \"$(ProjectDir)\\Plugins\\DynamicPersonalityAI\\Scripts\\pre-pre-preprocessor.py\" \"$(ProjectDir)\""
		]
	},
	"PostBuildSteps": {
		"Win64": [
			"@echo on & %PYTHONPATH% \"$(ProjectDir)\\Plugins\\DynamicPersonalityAI\\Scripts\\restore.py\" \"$(ProjectDir)\""
		]
	}
